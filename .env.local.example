# ---------------------------------------------------------------------------
# Local development. Copy to `.env.local`:
#
#   cp .env.local.example .env.local
#
# Every value here is generated by the local Supabase stack and is identical on
# every machine, so none of it is secret. Start the stack with `pnpm dev:up`.
# ---------------------------------------------------------------------------

APP_ENV=local
NEXT_PUBLIC_APP_ENV=local

# Supavisor transaction pooler — mirrors the production pooler (`prepare: false`).
# `postgres.pooler-dev` is the local tenant; Supavisor requires the tenant suffix.
DATABASE_URL=postgresql://postgres.pooler-dev:postgres@127.0.0.1:54329/postgres

# Direct connection, used by drizzle-kit for migrations and studio.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Kong gateway in front of the local GoTrue/PostgREST containers.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

AYT_API_BASE=https://api.ayt.co/v1
AYT_API_SOURCE=localhost
