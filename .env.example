# ---------------------------------------------------------------------------
# Canonical template. Copy to the file for the environment you are running:
#
#   local       -> .env.local        (see .env.local.example for filled values)
#   staging     -> Vercel "Preview"    env vars (dashboard, never a file)
#   production  -> Vercel "Production" env vars (dashboard, never a file)
#
# Never commit real secrets. Only *.example files are tracked.
# ---------------------------------------------------------------------------

# Which environment this process is running as. Drives logging verbosity and
# any environment banner in the CMS UI. One of: local | staging | production.
APP_ENV=local
NEXT_PUBLIC_APP_ENV=local

# --- Postgres --------------------------------------------------------------
# Runtime (app): pooler URL, transaction mode. `prepare: false` is set in
# src/db/client.ts and is REQUIRED for transaction-mode pooling.
#   local      -> postgresql://postgres:postgres@127.0.0.1:54329/postgres
#   staging    -> Supabase staging project pooler (port 6543)
#   production -> Supabase production project pooler (port 6543)
DATABASE_URL=

# Direct 5432 connection, used by drizzle-kit only (migrations + studio).
# The transaction pooler cannot run DDL reliably, so migrations bypass it.
#   local      -> postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=

# --- Supabase Auth (@supabase/ssr) -----------------------------------------
# Publishable key is safe to expose; RLS is enforced server-side.
#   local      -> http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- AYT (Alkitab Yang Terbuka) API — Indonesian scripture ------------------
# Docs: https://api.ayt.co/v1/
AYT_API_BASE=https://api.ayt.co/v1
AYT_API_SOURCE=your-domain.example.com
