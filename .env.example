# Supabase Postgres connection string.
# Runtime (app): use the pooler URL (port 6543, transaction mode) — safe for serverless.
# Migrations (drizzle-kit): if pooler causes issues, set DIRECT_URL to the direct 5432 URL
# and reference it from drizzle.config.ts. Single URL is fine to start.
DATABASE_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase SSR client (browser + server components + proxy).
# Publishable key is safe to expose (RLS enforced server-side).
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# AYT (Alkitab Yang Terbuka) API — Indonesian scripture
# Docs: https://api.ayt.co/v1/
AYT_API_BASE=https://api.ayt.co/v1
AYT_API_SOURCE=your-domain.example.com
